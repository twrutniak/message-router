# Wszystkie wartości mają domyślne ustawienia w docker-compose.yml,
# ten plik jest potrzebny tylko, jeśli chcesz coś nadpisać (np. model).
# Adresy poniżej (ollama, mailhog) działają w sieci Docker Compose. Przy uruchomieniu
# aplikacji lokalnie (poetry run uvicorn) ustaw OLLAMA_BASE_URL=http://localhost:11434/v1
# i SMTP_HOST=localhost.
OLLAMA_MODEL=qwen3.5:4b
# Tryb "myślenia" modelu: none = wyłączony (szybciej; wymagane dla modeli z thinking, np. qwen3.5).
# Dla modeli bez thinking wartość jest ignorowana.
OLLAMA_REASONING_EFFORT=none
OLLAMA_BASE_URL=http://ollama:11434/v1
SMTP_HOST=mailhog
SMTP_PORT=1025
MAIL_FROM=message-router@example.com
